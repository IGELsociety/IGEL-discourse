{"post_stream":{"posts":[{"id":794,"name":"Victoria Pöhls","username":"victoria_poehls","avatar_template":"/user_avatar/discourse.igelsociety.org/victoria_poehls/{size}/49_2.png","created_at":"2023-11-16T10:22:40.888Z","cooked":"\u003cp\u003eDear all,\u003c/p\u003e\n\u003cp\u003eI’m currently developing a ‘data management and sharing plan’ for the LitLab in Darmstadt (we do empirical research on reading literature, using eye tracking, EEG, fEMG, and peripheral physiology).\u003cbr\u003e\nAre there any data repositories to publish and share research data in the area of empirical literary studies that any of you uses or can recommend?\u003c/p\u003e\n\u003cp\u003eAny feedback much appreciated!\u003c/p\u003e","post_number":1,"post_type":1,"updated_at":"2023-11-16T10:22:40.888Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":6,"reads":22,"readers_count":21,"score":79.4,"yours":false,"topic_id":519,"topic_slug":"research-data-repositories-for-empirical-studies-on-literature-and-reading","display_username":"Victoria Pöhls","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_wiki":false,"read":true,"user_title":"","bookmarked":false,"actions_summary":[{"id":2,"count":1}],"moderator":false,"admin":false,"staff":false,"user_id":38,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"event":null,"calendar_details":[],"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"can_vote":false},{"id":796,"name":"Moniek Kuijpers","username":"moniek.kuijpers","avatar_template":"/user_avatar/discourse.igelsociety.org/moniek.kuijpers/{size}/23_2.png","created_at":"2023-11-17T11:51:08.505Z","cooked":"\u003cp\u003eHi Victoria,\u003c/p\u003e\n\u003cp\u003eI do not know of any repositories that are specific to our field (as of yet), but you could publish data in a general repository like Open Science Framework or Zenodo and then publish a short data paper in the Journal of Open Humanities Data, which would link to whichever repository you have chosen. In a way the JOHD functions as a repository for data gathered within humanities research that is made publicly available online.\u003c/p\u003e\n\u003cp\u003eHope this helps!\u003cbr\u003e\nMoniek\u003c/p\u003e","post_number":2,"post_type":1,"updated_at":"2023-11-17T11:51:08.505Z","reply_count":1,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":22,"readers_count":21,"score":69.4,"yours":false,"topic_id":519,"topic_slug":"research-data-repositories-for-empirical-studies-on-literature-and-reading","display_username":"Moniek Kuijpers","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_wiki":false,"read":true,"user_title":"","bookmarked":false,"actions_summary":[{"id":2,"count":2}],"moderator":true,"admin":false,"staff":true,"user_id":8,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"event":null,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false},{"id":797,"name":"Victoria Pöhls","username":"victoria_poehls","avatar_template":"/user_avatar/discourse.igelsociety.org/victoria_poehls/{size}/49_2.png","created_at":"2023-11-20T12:59:39.935Z","cooked":"\u003cp\u003eThanks, Moniek, especially for directing me to JOHD!\u003c/p\u003e","post_number":3,"post_type":1,"updated_at":"2023-11-20T12:59:39.935Z","reply_count":0,"reply_to_post_number":2,"quote_count":0,"incoming_link_count":0,"reads":21,"readers_count":20,"score":4.2,"yours":false,"topic_id":519,"topic_slug":"research-data-repositories-for-empirical-studies-on-literature-and-reading","display_username":"Victoria Pöhls","primary_group_name":null,"fla