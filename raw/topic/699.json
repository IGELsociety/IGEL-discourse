{"post_stream":{"posts":[{"id":1042,"name":"Dr Davide Castiglione","username":"Casti","avatar_template":"/user_avatar/discourse.igelsociety.org/casti/{size}/430_2.png","created_at":"2024-10-02T09:49:40.935Z","cooked":"\u003cp\u003eDear IGEL members,\u003c/p\u003e\n\u003cp\u003eI’d like to draw your attention to a resource I have recently developed. It is a database of nearly 100 literary (verbal) images, annotated along various stylistic dimensions. The images were selected according to certain criteria (i.e., they have been identified as such by literary critics, independently of my own judgment; and they refer to specific text parts). The website could be useful to select ROIs (Regions of Interest) marked for vivid language, to prepare experimental stimuli, and more. It is an ongoing project, so I hope it will grow in the upcoming months and years, representing more languages and genres. You are welcome to contribute to it or get involved in it! just write me at [email redacted]\u003c/p\u003e\n\u003cp\u003eMore information (and the database itself) at the link (see esp. the About page): \u003ca href=\"https://ideas-block.com/verbalimagesinliterature/\" rel=\"noopener nofollow ugc\"\u003eideas-block.com/verbalimagesinliterature/\u003c/a\u003e\u003c/p\u003e","post_number":1,"post_type":1,"updated_at":"2024-10-02T09:50:44.732Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":17,"reads":4,"readers_count":3,"score":85.8,"yours":false,"topic_id":699,"topic_slug":"verbal-images-in-literature-database-vild","display_username":"Dr Davide Castiglione","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"version":2,"can_edit":false,"can_delete":false,"can_recover":false,"can_wiki":false,"link_counts":[{"url":"https://ideas-block.com/verbalimagesinliterature/","internal":false,"reflection":false,"clicks":14}],"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":fal