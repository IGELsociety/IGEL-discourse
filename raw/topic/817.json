{"post_stream":{"posts":[{"id":1176,"name":"Frank Hakemulder","username":"Hakemulder","avatar_template":"/letter_avatar_proxy/v4/letter/h/898d66/{size}.png","created_at":"2025-06-02T05:42:12.701Z","cooked":"\u003cp\u003eWe are exploring the idea of creating a shared repository of \u003cstrong\u003eeducational materials for BA and MA students\u003c/strong\u003e in our field. The goal is to support teaching and learning by collecting and curating materials that are \u003cstrong\u003eopen access\u003c/strong\u003e or shareable \u003cstrong\u003evia a society’s portal\u003c/strong\u003e . These may include resources on methodologies, research techniques, and core content areas of empirical literary studies and related fields. At the Aachen conference last year, we started the conversation about setting something like this up; now seems a good time to make an inventory of what the interest and potential contributions might be. Therefore, we’d greatly appreciate your input via this short questionnaire (approx. 5 minutes).\u003c/p\u003e\n\u003cp\u003eHere is the \u003ca href=\"https://survey.uu.nl/jfe/form/SV_abcBS9CKzMPa63k\" rel=\"noopener nofollow ugc\"\u003elink\u003c/a\u003e to the survey.\u003c/p\u003e","post_number":1,"post_type":1,"updated_at":"2025-06-02T05:42:12.701Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":8,"reads":9,"readers_count":8,"score":86.8,"yours":false,"topic_id":817,"topic_slug":"sharing-educational-materials-in-empirical-literary-studies","display_username":"Frank Hakemulder","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_wiki":false,"link_counts":[{"url":"https://survey.uu.nl/jfe/form/SV_abcBS9CKzMPa63k","internal":false,"reflection":false,"title":"Qualtrics Survey | Qualtrics Experience Management","clicks":5}],"read":true,"user_title":null,"bookmarked":false,"actions_summary":[{"i