{"post_stream":{"posts":[{"id":108,"name":"Federico Pianzola","username":"fpianz","avatar_template":"/user_avatar/discourse.igelsociety.org/fpianz/{size}/188_2.png","created_at":"2022-02-17T10:56:33.586Z","cooked":"\u003cp\u003eThe IGEL board decided that it is most prudent to move the IGEL 2022 conference to a completely online format again for 2022. This means that there will be no face-to-face meetings in Orlando. We were all conflicted – of course, it would be wonderful to have to live meetings in sunny Orlando and to see everyone face-to-face; but, ultimately we all thought that the safety of our communities must be the top priority. We apologize for any inconvenience this may cause.\u003c/p\u003e\n\u003cp\u003eThe good news is that we have learned a lot about creating online communities and we believe that IGEL 2022 will continue to be a conference where we can connect with each other, share brilliant ideas, learn from one another and … of course … have fun doing all this!\u003c/p\u003e\n\u003cp\u003eTo give you an idea of what to expect from this format:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eIf you are giving a spoken presentation, you will need to create a 15–20-minute, pre-recorded video to be delivered (with captions) about 2 weeks before the conference.\u003c/li\u003e\n\u003cli\u003eDuring the conference sessions, a synchronous, online Q\u0026amp;A discussion of the video will be conducted by the presenter.\u003c/li\u003e\n\u003cli\u003eThe platform we will use for the conference is Concordance\u003cbr\u003e\n*Poster presentations will also be delivered through Concordance.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003ePlease don’t worry if you are concerned about specific technical requirements. More information is to come and there will be plenty of help!\u003c/p\u003e\n\u003cp\u003eLastly, remember the deadline for application is one week from now: \u003cstrong\u003eFebruary 24th by midnight CET (Central European Time)\u003c/strong\u003e.\u003cbr\u003e\nApplications can be submitted here: \u003ca href=\"https://ucf.qualtrics.com/jfe/form/SV_9nILT3HkoTKCctg\"\u003ehttps://ucf.qualtrics.com/jfe/form/SV_9nILT3HkoTKCctg\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003eIf you have any questions, you can contact the organizer, Shannon Whitten [email redacted]\u003c/p\u003e","post_number":1,"post_type":1,"updated_at":"2022-02-17T10:56:33.586Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":11,"reads":45,"readers_count":44,"score":79.0,"yours":false,"topic_id":87,"topic_slug":"igel-2022-moving-online","display_username":"Federico Pianzola","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_wiki":false,"link_counts":[{"url":"https://ucf.qualtrics.com/jfe/form/SV_9nILT3HkoTKCctg","internal":false,"reflection":false,"clicks":6}],"read":true,"user_title":"","bookmarked":false,"actions_summary":[{"id":2,"count":1}],"moderator":true,"admin":true,"staff":true,"user_id":1,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"event":null,"calendar_details":[],"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"can_vote":false}],"stream":[108]},"timeline_lookup":[[1,1687]],"suggested_topics":[{"id":846,"title":"PhD Vacancy Stavanger: Deep Reading in Higher Education","fancy_title":"PhD Vacancy Stavanger: Deep Reading in Higher Education","slug":"phd-vacancy-stavanger-deep-reading-in-higher-education","posts_count":1,"reply_count":0,"highest_post_number":1,"image_url":null,"created_at":"2026-02-03T10:30:59.964Z","last_posted_at":"2026-02-03T10:31:00.192Z","bumped":true,"bumped_at":"2026-02-03T10:31:00.192Z","archetype":"regular","unseen":false,"pinned":false,"unpinned":null,"visible":true,"closed":false,"archived":false,"bookmarked":null,"liked":null,"tags":[],"tags_descri