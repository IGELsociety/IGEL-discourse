      "description": "obfuscated address: local part, domain and tld with at and dot spelled out in (), [] or {}",
      "pattern": "(?i)(?:\\G|(?<![A-Za-z0-9._%+-]))[A-Za-z0-9._%+-]+[ \\t]*(?:\\([ \\t]*at[ \\t]*\\)|\\[[ \\t]*at[ \\t]*\\]|\\{[ \\t]*at[ \\t]*\\})[ \\t]*[A-Za-z0-9-]+(?:(?:[ \\t]*(?:\\([ \\t]*dot[ \\t]*\\)|\\[[ \\t]*dot[ \\t]*\\]|\\{[ \\t]*dot[ \\t]*\\})[ \\t]*|\\.)[A-Za-z0-9-]+)*[ \\t]*(?:\\([ \\t]*dot[ \\t]*\\)|\\[[ \\t]*dot[ \\t]*\\]|\\{[ \\t]*dot[ \\t]*\\})[ \\t]*[A-Za-z]{2,}",
      "replacement": "[email redacted]",
      "count": 1,
